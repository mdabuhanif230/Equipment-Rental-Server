PORT=5000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=replace-with-a-different-random-secret-at-least-32-characters-long

# MongoDB (Atlas > Connect > Drivers)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_CLUSTER=cluster0.xxxxx.mongodb.net
DB_NAME=equipment_rental

# Stripe
# Use the `sk_test_...` secret key or an appropriately permissioned `rk_test_...` restricted key.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Allowed client origins (comma-separated, include your Vercel URL in production)
CLIENT_URLS=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional comma-separated allowlist of first-party administrator accounts
ADMIN_EMAILS=admin@example.com

# Public Google OAuth client id (only needed for Google login)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Optional for server-side OAuth authorization-code flows; not needed for ID-token sign-in.
GOOGLE_CLIENT_SECRET=

# Optional: email notifications on completed rentals
RESEND_API_KEY=your_resend_key
EMAIL_FROM=RentGear <onboarding@resend.dev>
